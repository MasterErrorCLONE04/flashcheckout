{
  "version": "1.0.0",
  "lastUpdated": "2026-09-30T17:15:00.000Z",
  "roles": [
    {
      "id": "ROLE_MERCHANT",
      "name": "Comerciante (Merchant / Store Owner)",
      "description": "Dueño de tienda que configura catálogo, recibe pedidos y valida entregas",
      "authProvider": "Clerk Auth (Session JWT)",
      "guardMiddleware": "requireStoreOwner()"
    },
    {
      "id": "ROLE_SHOPPER",
      "name": "Comprador Final (Shopper)",
      "description": "Usuario que realiza pedidos vía enlace de checkout o chat WhatsApp",
      "authProvider": "Guest session / WhatsApp Phone verification",
      "guardMiddleware": "guestOrPhoneRateLimited()"
    },
    {
      "id": "ROLE_DRIVER",
      "name": "Repartidor (Delivery Driver)",
      "description": "Mensajero que recibe ofertas en radar y valida entregas con PIN",
      "authProvider": "OTP WhatsApp / SMS Driver Token",
      "guardMiddleware": "requireDriverAuth()"
    },
    {
      "id": "ROLE_ADMIN",
      "name": "SuperAdmin de Plataforma",
      "description": "Operador global con acceso a métricas de infraestructura, salud de bots y resolución de disputas",
      "authProvider": "Clerk Admin Role + 2FA",
      "guardMiddleware": "requirePlatformAdmin()"
    }
  ],
  "matrix": [
    {
      "resource": "Tienda & Configuración (Store Profile)",
      "permissions": {
        "ROLE_MERCHANT": ["create_own", "read_own", "update_own", "manage_breb"],
        "ROLE_SHOPPER": ["read_public_profile"],
        "ROLE_DRIVER": ["read_pickup_location"],
        "ROLE_ADMIN": ["read_all", "update_limits", "freeze_store"]
      }
    },
    {
      "resource": "Catálogo de Productos",
      "permissions": {
        "ROLE_MERCHANT": ["create", "read_own", "update_price_stock", "delete"],
        "ROLE_SHOPPER": ["read_active_products", "query_ai_catalog"],
        "ROLE_DRIVER": ["none"],
        "ROLE_ADMIN": ["read_all", "moderate_prohibited_items"]
      }
    },
    {
      "resource": "Órdenes de Compra (Orders)",
      "permissions": {
        "ROLE_MERCHANT": ["read_store_orders", "update_status", "dispatch_to_radar", "cancel_order"],
        "ROLE_SHOPPER": ["create_order", "read_own_order_status", "upload_proof"],
        "ROLE_DRIVER": ["read_assigned_order", "confirm_pickup", "validate_delivery_pin"],
        "ROLE_ADMIN": ["read_all", "override_status", "resolve_dispute"]
      }
    },
    {
      "resource": "Pagos Bre-B & Comprobantes OCR",
      "permissions": {
        "ROLE_MERCHANT": ["read_proofs", "manual_approve_proof", "reject_proof"],
        "ROLE_SHOPPER": ["generate_breb_intent", "upload_receipt_image"],
        "ROLE_DRIVER": ["read_payment_verified_badge"],
        "ROLE_ADMIN": ["audit_ocr_logs", "flag_fraudulent_proof"]
      }
    },
    {
      "resource": "Radar de Repartidores & Ofertas",
      "permissions": {
        "ROLE_MERCHANT": ["broadcast_order", "view_driver_position"],
        "ROLE_SHOPPER": ["view_driver_eta_on_map"],
        "ROLE_DRIVER": ["toggle_availability", "accept_offer", "reject_offer", "update_gps"],
        "ROLE_ADMIN": ["manage_driver_roster", "ban_fraudulent_driver"]
      }
    },
    {
      "resource": "Asistente Conversacional IA (Nova / DeepSeek)",
      "permissions": {
        "ROLE_MERCHANT": ["configure_ai_prompt", "view_chat_logs", "takeover_chat"],
        "ROLE_SHOPPER": ["send_query", "receive_recommendations"],
        "ROLE_DRIVER": ["none"],
        "ROLE_ADMIN": ["monitor_token_usage", "switch_llm_provider"]
      }
    }
  ]
}

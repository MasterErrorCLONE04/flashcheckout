{
  "version": "6.0",
  "routing_model": {
    "CATALOG": [
      "CHECKOUT"
    ],
    "CHECKOUT": []
  },
  "screens": [
    {
      "id": "CATALOG",
      "title": "${data.store_name}",
      "data": {
        "store_name": {
          "type": "string",
          "__example__": "Flashcheckout Store"
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "prod_sample_1",
              "title": "Vestido Floral Rojo",
              "description": "$25.000 COP • Talla M"
            },
            {
              "id": "prod_sample_2",
              "title": "Camisa Lino Blanca",
              "description": "$35.000 COP • Talla L"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "catalog_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Catálogo de Productos 🛍️"
              },
              {
                "type": "TextSubheading",
                "text": "Selecciona los productos que deseas añadir a tu pedido:"
              },
              {
                "type": "CheckboxGroup",
                "name": "selections",
                "label": "Productos Disponibles",
                "required": true,
                "data-source": "${data.products}"
              },
              {
                "type": "Footer",
                "label": "Siguiente: Datos de Envío ➡️",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CHECKOUT"
                  },
                  "payload": {
                    "selections": "${form.selections}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CHECKOUT",
      "title": "Datos de Envío 📍",
      "terminal": true,
      "success": true,
      "data": {
        "selections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": [
            "prod_sample_1"
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "checkout_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Finaliza tu Pedido 📦"
              },
              {
                "type": "TextSubheading",
                "text": "Ingresa los datos para la entrega de tus productos:"
              },
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Nombre Completo",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "address",
                "label": "Dirección de Entrega",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "TextInput",
                "name": "city",
                "label": "Ciudad",
                "required": true,
                "input-type": "text"
              },
              {
                "type": "Footer",
                "label": "Confirmar y Elegir Pago ✅",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "selections": "${data.selections}",
                    "full_name": "${form.full_name}",
                    "address": "${form.address}",
                    "city": "${form.city}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
